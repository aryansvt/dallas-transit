{
  "name": "dallas-transit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dallas-transit/web --filter @dallas-transit/api dev",
    "build": "pnpm -r build",
    "lint": "eslint . && pnpm --filter @dallas-transit/web lint",
    "typecheck": "pnpm --filter @dallas-transit/gtfs --filter @dallas-transit/router build && pnpm -r typecheck",
    "test": "pnpm --filter @dallas-transit/gtfs --filter @dallas-transit/router build && vitest run",
    "test:integration": "pnpm --filter @dallas-transit/gtfs --filter @dallas-transit/router build && node --env-file-if-exists=workers/transit-ingest/.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:router": "vitest run packages/router",
    "test:journey": "pnpm --filter @dallas-transit/router build && vitest run packages/router/src/geographic.test.ts workers/transit-ingest/src/geographic-planner.test.ts workers/transit-ingest/src/walking-provider.test.ts workers/transit-ingest/src/valhalla-walking.test.ts",
    "journey:validate": "pnpm --filter @dallas-transit/transit-ingest... build && node --env-file-if-exists=workers/transit-ingest/.env workers/transit-ingest/dist/journey-cli.js",
    "routing:validate": "pnpm --filter @dallas-transit/transit-ingest... build && node --env-file-if-exists=workers/transit-ingest/.env workers/transit-ingest/dist/routing-cli.js",
    "gtfs": "pnpm --filter @dallas-transit/transit-ingest... build && node --env-file-if-exists=workers/transit-ingest/.env workers/transit-ingest/dist/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose --project-directory infra/docker -f infra/docker/compose.yaml up -d --wait --wait-timeout 120",
    "infra:down": "docker compose --project-directory infra/docker -f infra/docker/compose.yaml down",
    "infra:config": "docker compose --project-directory infra/docker -f infra/docker/compose.yaml config --quiet",
    "infra:status": "docker compose --project-directory infra/docker -f infra/docker/compose.yaml ps"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
