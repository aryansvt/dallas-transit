# Same-origin server proxy. Never supplied by a browser query parameter.
TRANSIT_API_ORIGIN=http://127.0.0.1:3001
# Production: HTTPS Render origin, no path. Server-only, never NEXT_PUBLIC_.
# TRANSIT_PROXY_KEY=<same-random-server-only-key-as-Render>

# PUBLIC browser token (pk. only): Mapbox Search Box and Light v11 Static Tiles.
# Required for production builds. Restrict token URLs to authorized web origins.
# Never put an sk. token or GEOAPIFY_API_KEY in NEXT_PUBLIC_* variables.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace_with_public_token
