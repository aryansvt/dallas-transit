# Same-origin server proxy. Never supplied by a browser query parameter.
TRANSIT_API_ORIGIN=http://127.0.0.1:3001

# Optional approved/operated MapLibre style URL. No demo or external default.
# Referenced tiles, glyphs and sprites also need approved hosting/attribution.
# Browser-visible; do not put a secret in it.
# NEXT_PUBLIC_MAP_STYLE_URL=http://127.0.0.1:8080/style.json
