  "narrative": {
    "northStar": "The Station Board",
    "overview": "LineFinder reads like the departure board at a well-run station, calmed down for a phone. Paper canvas for browsing, Board Ink panels for the facts that matter most, Signal Amber as the single voice.\n\nInformation leads. Scheduled data always says so in words.\n\nIt must never look like DART.",
    "keyCharacteristics": [
      "Paper canvas with Board Ink panels and one amber voice",
      "Barlow and Barlow Semi Condensed, tabular numerals for every time",
      "Hairline borders and tonal surfaces; shadows only on floating things",
      "48px minimum targets, 3px focus rings, safe-area aware"
    ],
    "rules": [
      {
        "name": "The One Amber Rule",
        "body": "Amber is a fill on ink or a button, never body text on paper.",
        "section": "colors"
      },
      {
        "name": "The Scheduled Rule",
        "body": "A Scheduled tag or label is within one screen of every time.",
        "section": "colors"
      },
      {
        "name": "The Not-DART Rule",
        "body": "No agency logo, wordmark or palette in chrome.",
        "section": "colors"
      },
      {
        "name": "The Tabular Time Rule",
        "body": "Every time and duration uses tabular figures and never wraps.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Cards and the planner carry no shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do lead with the next action and the time.",
      "Do keep a Scheduled label near every time.",
      "Do use tabular figures and condensed bold for times.",
      "Do keep 48px targets and 16px or larger inputs.",
      "Do keep the independence note on home, About and Privacy."
    ],
    "donts": [
      "Don't use DART's logo, name as brand, or palette.",
      "Don't put amber text on paper.",
      "Don't add shadows to static cards or colored side stripes.",
      "Don't convey status by color alone.",
      "Don't use em dashes or marketing-sounding copy."
    ]
  }
