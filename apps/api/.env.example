# Optional local overrides. Node loads apps/api/.env in dev/start scripts.
HOST=127.0.0.1
PORT=3001

# Public local-only Compose example. Set explicitly in production.
# Keep aligned with infra/docker/.env if you customize the local service.
DATABASE_URL=postgresql://dallas_dev:local_only_password@127.0.0.1:5432/dallas_transit
DATABASE_POOL_SIZE=4

# No walking service is enabled by default. Use an operated/authorized endpoint.
# Full HTTP(S) /route URL; no credentials, query string, fragment or redirects.
# WALKING_VALHALLA_URL=http://127.0.0.1:8002/route

JOURNEY_TIMEOUT_MS=15000
JOURNEY_CONCURRENCY=4
SCHEDULE_CACHE_ENTRIES=2
SCHEDULE_CACHE_TTL_MS=300000
# Scenario allowance after the first boarding; not verified station walking time.
TRANSIT_CHANGE_SECONDS=120
