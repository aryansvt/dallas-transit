# Optional local overrides. Node loads apps/api/.env in dev/start scripts.
HOST=127.0.0.1
PORT=3001
# Local values above only. Render: omit HOST/PORT; production binds 0.0.0.0
# and reads Render's injected PORT. See docs/DEPLOYMENT.md.
# Required server-to-server secret in production; same value in Vercel.
# TRANSIT_PROXY_KEY=<random-32-byte-base64url-key>

# Public local-only Compose example. Set explicitly in production.
# Keep aligned with infra/docker/.env if you customize the local service.
DATABASE_URL=postgresql://dallas_dev:local_only_password@127.0.0.1:5432/dallas_transit
DATABASE_POOL_SIZE=4
# Render internal DATABASE_URL: use ?sslmode=require (private self-signed TLS).
# External administrative URL: ?sslmode=verify-full (verified TLS).

# SERVER-ONLY secret. Required in production; never use NEXT_PUBLIC_ for this key.
# GEOAPIFY_API_KEY=replace_with_private_key
# Geoapify v1 HTTPS routing, walk mode; no search/geocoding use.
# Optional local validation alternative only; mutually exclusive with Geoapify.
# Full HTTP(S) /route URL; no credentials, query string, fragment or redirects.
# WALKING_VALHALLA_URL=http://127.0.0.1:8002/route

JOURNEY_TIMEOUT_MS=15000
JOURNEY_CONCURRENCY=4
SCHEDULE_CACHE_ENTRIES=2
SCHEDULE_CACHE_TTL_MS=300000
# Scenario allowance after the first boarding; not verified station walking time.
TRANSIT_CHANGE_SECONDS=120
# Realtime stays disabled until official DART access and publication-ID
# compatibility have been confirmed by an authorized operator.
# DART_REALTIME_AUTHORIZED=true
# DART_REALTIME_PUBLICATION_ID=<verified-static-publication-uuid>
# DART_REALTIME_FEED_URLS=<documented-https-feed-url>[,<second>,<third>]
# DART_REALTIME_AUTH_HEADER=<documented-header-name>
# DART_REALTIME_KEY=<operator-provided-key; never commit>
# DART_REALTIME_INTERVAL_MS=60000
# DART_REALTIME_AGENCY_IDS=<verified-agency-ids-in-this-publication>
# DART_REALTIME_SMOKE=true # manual smoke command only
