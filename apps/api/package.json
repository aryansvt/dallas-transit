{
  "name": "@dallas-transit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -w test:api"
  },
  "dependencies": {
    "@dallas-transit/shared": "workspace:*",
    "fastify": "5.12.5",
    "@dallas-transit/router": "workspace:*",
    "@dallas-transit/gtfs": "workspace:*",
    "@dallas-transit/transit-ingest": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "@types/pg": "8.23.1"
  }
}
